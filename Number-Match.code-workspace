{
	"extensions": {
		"recommendations": [
			"katsute.code-background",
			"runarsf.platform-settings"
		]
	},

	"folders": [
		{ "path": ".", "name": "repo" },
		{ "path": "src", "name": "App" },
		{ "path": "lib" }
	],

	"settings": {
		"cmake.sourceDirectory": "${workspaceFolder:repo}",

		"search.exclude": { // searching symbols
			"**/build/**": true,
			"**/bin/**": true,
			"**/external/**": true
		},
		"files.exclude": { // explorer
			"src/**": true,
			"lib/**": true
		},
		"C_Cpp.files.exclude": { // intellisense
			"**/build/**": true,
			"**/bin/**": true,
			"**/external/**": true
		},

		"C_Cpp.default.browse.limitSymbolsToIncludedHeaders": true,
		"C_Cpp.workspaceParsingPriority": "low",
	},

	"launch": {
		"version": "0.2.0",
		"configurations": [
			{
				"name": "Debug NumberMatch",
				"type": "lldb",
				"request": "launch",
				"program": "${command:cmake.launchTargetPath}",
				"cwd": "${workspaceFolder:repo}",
				"stopOnEntry": false,
				"preLaunchTask": "CMake: build",
				"args": []
			}
		],
		"compounds": []
	}
}