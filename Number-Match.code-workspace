{
	"extensions": {
		"recommendations": [
			"katsute.code-background",
			"runarsf.platform-settings"
		]
	},

	"folders": [
		{ "path": ".", "name": "repo" },
		{ "path": "src", "name": "App" },
		{ "path": "lib" }
	],

	"settings": {
		"cmake.sourceDirectory": "${workspaceFolder:repo}",

		"search.exclude": { // searching symbols
			"${workspaceFolder:repo}/build/**": true,
			"${workspaceFolder:repo}/bin/**": true,
			"${workspaceFolder:lib}/raylib/**": true,
			"${workspaceFolder:lib}/nlohmann/**": true
		},
		"C_Cpp.files.exclude": { // intellisense
			"${workspaceFolder:repo}/build/**": true,
			"${workspaceFolder:repo}/bin/**": true,
			"${workspaceFolder:lib}/raylib/**": true,
			"${workspaceFolder:lib}/nlohmann/**": true
		},
		"C_Cpp.default.browse.path": [
			"${workspaceFolder:repo}"
		],

		// pretty backgrounds
		"background.settingScope": "Workspace",
		"background.useInvertedOpacity": true,

		"platformSettings.platforms": {
			"win32": { "background.backgroundOpacity": [ 0.95, 0.93, 0.83, 0.95 ] },
			"linux": { "background.backgroundOpacity": [ 0.05, 0.07, 0.17, 0.05 ] },
			"darwin": { "background.backgroundOpacity": [ 0.95, 0.93, 0.83, 0.95 ] } // mac
		},

		"background.backgroundSize": [ "Cover", "Cover", "Cover", "Cover" ],
		"background.autoInstall": true,
		"background.backgroundChangeTime": [1800, 1200, 600, 1800], // 30 mins
		"background.backgroundAlignment": [
			"Center Center",
			"Center Center",
			"Top Left",
			"Center Center"
		],

		"background.editorBackgrounds": [
			"https://raw.githubusercontent.com/lishacodesgames/Number-Match/main/vscode-backgrounds/editor/1.png",
			"https://raw.githubusercontent.com/lishacodesgames/Number-Match/main/vscode-backgrounds/editor/2.png",
			"https://raw.githubusercontent.com/lishacodesgames/Number-Match/main/vscode-backgrounds/editor/3.png",
			"https://raw.githubusercontent.com/lishacodesgames/Number-Match/main/vscode-backgrounds/editor/4.png",
			"https://raw.githubusercontent.com/lishacodesgames/Number-Match/main/vscode-backgrounds/editor/5.gif"
		],
		"background.sidebarBackgrounds": [
			"https://raw.githubusercontent.com/lishacodesgames/Number-Match/main/vscode-backgrounds/sidebar/1.png",
			"https://raw.githubusercontent.com/lishacodesgames/Number-Match/main/vscode-backgrounds/sidebar/2.png",
			"https://raw.githubusercontent.com/lishacodesgames/Number-Match/main/vscode-backgrounds/sidebar/3.png",
			"https://raw.githubusercontent.com/lishacodesgames/Number-Match/main/vscode-backgrounds/sidebar/4.png",
			"https://raw.githubusercontent.com/lishacodesgames/Number-Match/main/vscode-backgrounds/sidebar/5.png"
		],
		"background.panelBackgrounds": [
			"https://raw.githubusercontent.com/lishacodesgames/Number-Match/main/vscode-backgrounds/panel/1.png",
			"https://raw.githubusercontent.com/lishacodesgames/Number-Match/main/vscode-backgrounds/panel/2.png",
			"https://raw.githubusercontent.com/lishacodesgames/Number-Match/main/vscode-backgrounds/panel/3.png",
			"https://raw.githubusercontent.com/lishacodesgames/Number-Match/main/vscode-backgrounds/panel/4.png",
			"https://raw.githubusercontent.com/lishacodesgames/Number-Match/main/vscode-backgrounds/panel/5.png"
		],
	},

   // editor colors
   "editor.tokenColorCustomizations": {
      "textMateRules": [
         {
            "scope": "comment",
            "settings": {
               "foreground": "#653F31",
               "fontStyle": "italic bold"
            }
         },
         { // anything in quotes
            "scope": ["string.quoted.double", "string.quoted.single"],
            "settings": {
               "foreground": "#95d7ca",
            },
         },
         { // operators like +, -, ==, etc
            "scope": ["keyword.operator", "punctuation.separator"],
            "settings": {
               "foreground": "#4a8bbc",
            },
         },
         { // numeric constants
            "scope": ["constant.character", "constant.numeric"],
            "settings": {
               "foreground": "#5bad6e",
            },
         },
      ],
   },
   "editor.semanticTokenColorCustomizations": {
      "rules": {
         "namespace": "#ff5100",
         "property": { // class members
            "foreground": "#eaa3a3",
            "fontStyle": "italic",
         },
         "method": "#fb8c8c", // class methods
         "operator": "#477aa1", // operators like +, -, ==, etc
         "variable": { // local variables
            "foreground": "#6cbde5",
         },
      },
   },
}